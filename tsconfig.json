{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "bun"
    ],
    "lib": [
      "ES2023",
      "DOM"
    ],
    "noUnusedLocals": true
  },
  "include": [
    "src/main",
    "src/engine",
    "src/shared",
    "tests"
  ]
}
